        <item>
         <widget class="QLabel" name="lbl_date_text">
          <property name="styleSheet">
           <string notr="true">background-color: none;
font-size: 14pt;</string>
          </property>
          <property name="text">
           <string>В Республике Коми расследуется дерзкое ограбление: в ночь на 10 октября в городе Воркута группа неизвестных лиц совершила тщательно спланированное нападение на материально-технический склад крупного горно-обогатительного комбината, расположенный на промышленной окраине города.
Злоумышленники профессионально нейтрализовали охранную сигнализацию и вывели из строя систему внешнего видеонаблюдения, после чего проникли в основное помещение склада, откуда похитили партию дорогостоящего промышленного оборудования общего назначения и специализированных геодезических приборов общей стоимостью более 15 миллионов рублей. По предварительным данным следствия, преступники действовали по наводке, отлично знали график обхода территории ведомственной охраной и использовали для вывоза тяжелого груза подготовленный полноприводный грузовой автомобиль высокой проходимости.
Скрываясь с места преступления в условиях сильной осенней метели, нападавшие направились в сторону развалин заброшенного посёлка-призрака Рудник, где следы тяжелой техники затерялись; в настоящее время в регионе объявлен план «Перехват», на въездах в город выставлены дополнительные посты ГИБДД, а оперативные службы опрашивают возможных свидетелей и проверяют пункты приема лома и черных металлов.</string>
          </property>
          <property name="textFormat">
           <enum>Qt::TextFormat::AutoText</enum>
          </property>
          <property name="alignment">
           <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignTop</set>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
